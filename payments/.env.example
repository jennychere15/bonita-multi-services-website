# Defaults to sandbox. Configure these in the backend host's secret manager, never GitHub Pages.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
ADMIN_TOKEN=
BASE_URL=http://localhost:4242
PORT=4242
DATABASE_PATH=./data/payments.sqlite
# Transactional email stays paused until a sender is verified and a key is configured.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Bonita Multi-Services <notifications@updates.bonitamultiservices.com>
BMS_ADMIN_EMAIL=Admin@bonitamultiservices.com
SANDBOX_EMAIL_ALLOWLIST=Admin@bonitamultiservices.com,admin+provider-test@bonitamultiservices.com

# Use a separate live service and fresh database; see PRODUCTION.md.
PAYMENT_MODE=sandbox
LIVE_PAYMENTS_ENABLED=false
# OAuth exchange may need a separate standard key of the same mode.
STRIPE_OAUTH_SECRET_KEY=
